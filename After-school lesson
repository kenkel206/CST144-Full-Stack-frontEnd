<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>After School lesson</title>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="Lessons.js"></script>
</head>
<body>
    
    <script type="module">
        const {createApp} = Vue
        const myApp = createApp({
            data(){
                return{
                lesson: {
                    LessonID:1,
                    Subject: "Math",
                    availability:10,
                    location:"56B",
                    Price: 25,
                    image:"https://images.unsplash.com/photo-1509228468518-180dd4864904?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
                    alt:"a picture of the word math"
                    },
                    
                    lessons: LessonsArray,
                 cart:[],
                Name: "",
                Phone:"",
                Email:"",
                displayCart:false,
                orderConfirmed:false,
                PricingOrder:false,
                increasingOrder:true,
                SortType: "Price",
                }
                
            },
            computed:{
                    
            },
            methods:{
                //puts id in the cart
                addToCart(){
                    this.cart.push(this.LessonID);
                
                },
                //puts id in the cart array and geets rid of avialability
                addToCart(lesson){
                    this.cart.push(lesson.LessonID);
                    lesson.availability--;
                },
                removeFromCart(lesson){
                    this.cart.pop(lesson.lessonID);
                    lesson.availability++;
                },
               //decides if checkout page should be on or not
                toggleCheckout(){
                    this.displayCart = this.displayCart ? false: true; 
                },
                //checks if there is available spaces
                canAddToCart(lesson){
                    return lesson.availability > 0;
                },
                isCartEmpty(){
                     return this.cart.length === 0;   
                },
                isDetailsMissing(){
                    return this.Name !=="" && this.Phone !="";
                },
                //how many subjects are to be bought
                cartCount(id) {
                    let count = 0;
                    for(var i = 0; i < this.cart.length; i++) {
                    if (this.cart[i] === id) {
                        count++;
                        }   
                    }
                    return count;
                },
                toggleOrderConfirmed(){
                    this.orderConfirmed = this.orderConfirmed ? false: true;
                },
                toggleSortOrder(){
                    this.increasingOrder = !this.increasingOrder;
                },
                async fetchData() {
                const url = 'http://localhost:3000/';
                let response = await fetch(url);
                this.lessons = await response.json();
                },
                 SetSortType(aSortType){
                    this.SortType = aSortType;
                },
               sortedLessons(){  
                let LessonsArray =[...this.lessons];

                if (this.SortType === "Price"){
                    if(this.lessons.length > 0) {
                        function compare(a, b){
                            if(a.Price < b.Price)
                                return -1;
                            if(a.Price > b.Price)
                                return 1;
                            return 0;
                        }
                        return this.increasingOrder ? 
                        LessonsArray.sort(compare): LessonsArray.sort(compare).reverse(); 
                        
                    }
                }
                if(this.SortType ==="Subject"){
                        if(this.lessons.length > 0) {
                        function compare(a, b){
                            if(a.Subject.toLowerCase() < b.Subject.toLowerCase())
                                return -1;
                            if(a.Subject.toLowerCase() > b.Subject.toLowerCase())
                                return 1;
                            return 0;
                        }
                         return this.increasingOrder ?
                         LessonsArray.sort(compare): LessonsArray.sort(compare).reverse();
                    }
                }     
                if(this.SortType === "availability"){
                        if(this.lessons.length > 0) {
                        function compare(a, b){
                            if(a.availability < b.availability)
                                return -1;
                            if(a.availability > b.availability)
                                return 1;
                            return 0;
                        }
                         return this.increasingOrder ?
                         LessonsArray.sort(compare):LessonsArray.sort(compare).reverse();
                    }  
                     
                
                }
                   
               }
            },
            created(){
                this.fetchData();
            } 
               
            })
            
        myApp.mount('#app')
    </script>
    <div id= "app">
    <div v-if="!displayCart">
        <button @click="toggleCheckout" v-bind:disabled="isCartEmpty()">Shopping Cart</button><br>
        <button @click="SetSortType('Price')">price</button><button @click="SetSortType('Subject')">Subject</button><button @click="SetSortType('availability')">availability</button><br>
        <button @click="toggleSortOrder">asc/desc</button>
        <div v-for="lesson in sortedLessons()">  
            <h1 v-text="lesson.Subject"></h1>
            <h3>classroom <em>{{ lesson.location }}</em></h3>
            <p>{{ lesson.availability }} spaces available</p>
            <p>£{{ lesson.Price }}</p>
            <img v-bind:src="lesson.image" v-bind:alt="lesson.alt" width="300"><br><br>
           <button v-on:click="addToCart(lesson)" v-bind:disabled="!canAddToCart(lesson) ">add to cart</button>
            <p>{{ cart.length }} items in cart</p>
        </div> 
    </div>
     <div v-else>
        <h1>Shopping Cart</h1>
        <button @click="toggleCheckout">Shopping Cart</button><br>
         <div v-for="lesson in cart">  
            <h1 v-text="lesson.Subject"></h1>
            <h3>classroom <em>{{ lesson.location}}</em></h3>
            <button v-on:click="removeFromCart(lesson)">remove from cart</button>
        </div> 
        name <input v-model="Name"><br>
        phone <input v-model="Phone"><br>
        email <input v-model="Email"><br>
        <button :disabled="!isDetailsMissing()" @click="toggleOrderConfirmed">Checkout</button>
        <p v-if="orderConfirmed">order confirmed</p> 
     </div>
    </div>

</body>
</html>
